package oops_day1;
import java.util.*;
class A {
    int A(){
        return 1;
    }
    int reverse (){
        Scanner rs=new Scanner(System.in);
        System.out.println("enter a no");
        int a=rs.nextInt();
        int rev=0;
        while(a!=0) {
            int pop = a % 10;
             rev = rev * 10 + pop;
            a = a / 10;
        }
        return rev;
    }
}
public class reverse_int {
    public static void main(String[]args) {
        A obj=new A();
        System.out.println(obj.reverse());
    }
}
